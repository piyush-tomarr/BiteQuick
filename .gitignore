# =========================================
# Monorepo .gitignore — React (Vite) + Node/Express
# Place this at the repo root (covers frontend/ and backend/)
# =========================================

# ---- Dependencies ----
node_modules/
frontend/node_modules/
backend/node_modules/
jspm_packages/

# ---- Environment variables (never commit secrets) ----
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ---- Build output ----
dist/
build/
frontend/dist/
frontend/build/
backend/dist/
backend/build/
.next/
out/

# ---- Vite ----
.vite/
*.local

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Package manager artifacts ----
.pnpm-store/
.yarn/
.yarn-integrity
.npm/

# ---- Testing / coverage ----
coverage/
.nyc_output/
*.lcov

# ---- Cache ----
.cache/
.eslintcache
.parcel-cache/
.turbo/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- OS files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ---- Runtime / process ----
pids/
*.pid
*.seed
*.pid.lock

# ---- TypeScript ----
*.tsbuildinfo

# ---- Misc ----
*.tgz
.temp/
.tmp/
